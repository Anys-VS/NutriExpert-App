<?xml version="1.0" encoding="utf-8"?>
<!-- Primer plano del ícono: la N con la hoja de logo.xml, achicada al centro
     para que Android pueda recortar el ícono en círculo o cuadrado sin cortarla. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.135"
        android:scaleY="0.135"
        android:translateX="19.6"
        android:translateY="18.9">

        <!-- Letra N -->
        <path
            android:pathData="M142,354V166L368,354V218"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="58"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- Hoja -->
        <path android:pathData="M350,215C358,155 406,123 458,137C449,193 410,221 350,215Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="366"
                    android:startY="145"
                    android:endX="438"
                    android:endY="216"
                    android:startColor="#FFF1F8E9"
                    android:endColor="#FFA5D6A7" />
            </aapt:attr>
        </path>

        <!-- Nervio de la hoja -->
        <path
            android:pathData="M364,204C385,197 406,184 426,165"
            android:strokeColor="#FF1B5E20"
            android:strokeWidth="12"
            android:strokeLineCap="round" />
    </group>
</vector>
