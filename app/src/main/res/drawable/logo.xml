<?xml version="1.0" encoding="utf-8"?>
<!-- Símbolo de NutriExpert convertido desde nutriexpert-logo.svg.
     Android no lee .svg directo: se usa este vector. El texto "NutriExpert"
     no va aquí (los vectores no soportan texto); se escribe con Text en Compose. -->
